# INSPEC360 - Variáveis de Ambiente

# URL da API Backend — rota relativa. O servidor Vite de desenvolvimento
# (vite.config.ts) já faz proxy de /api para http://localhost:3001, e em
# produção o próprio Express serve o build e a API na mesma origem. Uma URL
# absoluta aqui (ex.: http://localhost:3001/api) contorna esse proxy e causa
# erro de CORS no navegador — use sempre /api.
VITE_API_URL=/api

# Modo desenvolvimento — mostra o aviso com as 3 contas de teste na tela de
# login. Deixe "false" (ou remova) antes de publicar de verdade.
VITE_DEV_MODE=true

# Ambiente
VITE_ENV=development
